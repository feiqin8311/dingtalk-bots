# 可复用 logistics/cp 钉钉凭证；也可用 LCL_DING_* 覆盖
# CLIENT_ID=
# CLIENT_SECRET=
# ROBOT_CODE=

# 角色（逗号分隔 userId）；都空则开放物流角色
# LCL_LOGISTICS_USERS=
# LCL_OPERATION_USERS=
# LCL_TECHNOLOGY_USERS=
# LCL_OTHER_USERS=

# 工作目录（默认 apps/lcl_bot）
# LCL_BASE_DIR=/app/apps/lcl_bot

# Common 包根（含 Common/ 子目录），默认 monorepo 上级
# LCL_COMMON_ROOT=/yida

# 登记表 / 共享盘（可选覆盖）
# LCL_REGISTER_EXCEL_PATH=
# LCL_EZARC_FOLDER_BASE=
# LCL_TOLESA_FOLDER_BASE=
