# 可复用 logistics/cp 钉钉凭证；也可用 LCL_DING_* 覆盖
# CLIENT_ID=
# CLIENT_SECRET=
# ROBOT_CODE=

# 角色；物流白名单空=开放
# LCL_LOGISTICS_USERS=
# 运营与流程三共用（pinxiang）：只配 PINXIANG_OPS_USERS=姓名:userId,...
# PINXIANG_OPS_USERS=袁皓冉:17839075860894598,陈潇潇:17403614178121993
# LCL_TECHNOLOGY_USERS=
# LCL_OTHER_USERS=

# 工作目录（默认 apps/lcl_bot）
# LCL_BASE_DIR=/app/apps/lcl_bot

# 删单用本仓库领星配置（与 CP 共用，通常在仓库根 .env）
# LINGXING_API_HOST=http://121.41.4.126:3188
# LINGXING_API_KEY=
# LINGXING_API_SECRET=
# LINGXING_TOKEN_URL=http://121.41.4.126:3721/token
# LINGXING_TOKEN_REQUEST_KEY=
# LINGXING_SSL_VERIFY=false
