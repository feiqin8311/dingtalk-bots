# 平谊 / 软通宝（FBA 编码 getTrack）
PINGYI_BASE_URL=http://hzpy.rtb56.com
PINGYI_APP_TOKEN=
PINGYI_APP_KEY=

# 龙舟/堡森：物流查询网关（logistics_no 直查 AGL）
# 容器内默认 host.docker.internal；本机可写 http://127.0.0.1:18743 或公网 IP
LOGISTICS_GATEWAY_BASE_URL=http://host.docker.internal:18743
LOGISTICS_GATEWAY_API_KEY=
# AGL 单查约 60–90s，勿设过短（误超时）；默认 240
LOGISTICS_GATEWAY_TIMEOUT_SEC=240
# 龙舟 AGL 网关并发（默认 1=串行护网关；不要盲目调高）
LOGISTICS_GATEWAY_MAX_CONCURRENT=1
# 两次 AGL 启动最小间隔秒（0=不额外 sleep；串行时单票本身已很慢）
LOGISTICS_GATEWAY_MIN_INTERVAL_SEC=0
# 行级线程池（平谊可并行；龙舟仍受上面 MAX_CONCURRENT 闸门）
TRACK_QUERY_WORKERS=4
# 是否推送钉钉文件：0=只生成 Excel 到 exports/，1=生成并推送负责人
TRACK_SEND_EXCEL=0

# 钉钉智能表格 2025New！
TRACK_DINGTALK_DOC_KEY=R1zknDm0WRl1kQwrCZ9rmxxDJBQEx5rG
TRACK_DINGTALK_SHEET_ID=0r21tyL
TRACK_DINGTALK_VIEW_ID=6n38xji
# 读表 operatorId（柯鹏翔 unionId）
TRACK_OPERATOR_UNION_ID=iiTcqTk5siSYoBBbKR7hRGiSQiEiE
# 货代筛选，逗号分隔（默认平谊+龙舟+美通+堡森）
TRACK_CARRIER_KEYWORDS=平谊,龙舟,美通,堡森
# 美通：物流编号 → GET /v1/track/aafOrderTrack/getTrackInfo
MEITONG_BASE_URL=https://www.szaaf.com
MEITONG_USERNAME=
MEITONG_PASSWORD=
MEITONG_TIMEOUT_SEC=30
MEITONG_RETRIES=2
# 发货时间年份（列「发货时间」为毫秒时间戳）；填 all 表示不限年
TRACK_SHIP_YEAR=2026

# 通知复用物流机器人凭证
# LOGISTICS_DING_CLIENT_ID=
# LOGISTICS_DING_CLIENT_SECRET=
# LOGISTICS_DING_ROBOT_CODE=

TRACK_NOTIFY_STATE_DIR=apps/track_notify/.state
