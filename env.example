# dingtalk-bots 统一环境变量（复制为仓库根 .env，勿提交 git）
# cp env.example .env
#
# Docker 与进程均优先读此文件。apps/*/.env 仅兼容旧部署、补缺。

# ========== 钉钉（物流部统一 Stream 机器人）==========
LOGISTICS_DING_CLIENT_ID=
LOGISTICS_DING_CLIENT_SECRET=
LOGISTICS_DING_ROBOT_CODE=
# 兼容别名（CP 等仍可读）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=
DING_TECH_USER_IDS=

# Stream
DING_STREAM_WS_PING_INTERVAL=30
DING_STREAM_WS_PING_TIMEOUT=120

# ========== MySQL 调用日志 ==========
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dingtalk_bot
DB_CONNECT_TIMEOUT_SEC=5
BOT_CALL_LOG_TABLE=fact_dingtalk_bot_call_log

# ========== 流程1 CP：领星 / OCR / 地址簿 ==========
LINGXING_API_HOST=http://121.41.4.126:3188
LINGXING_API_KEY=
LINGXING_API_SECRET=
LINGXING_TOKEN_URL=http://121.41.4.126:3721/token
LINGXING_TOKEN_REQUEST_KEY=
LINGXING_SSL_VERIFY=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ADDRESS_BOOK_XLSX_PATH=files/全站点地址.xlsx
SMB_USERNAME=
SMB_PASSWORD=
SMB_PORT=445
SMB_TIMEOUT_SEC=30
SMB_CLIENT_NAME=dingtalk-cp-bot

# ========== 流程2 拆分 ==========
LOGISTICS_SPLIT_WORKSPACE=apps/split_bot/.bot-workspace

# ========== 流程3 不分仓拼箱 ==========
PINXIANG_WORKSPACE=apps/pinxiang_bot/.bot-workspace
PINXIANG_PRODUCT_INFO_PATH=files/产品信息单证专用.xlsx
# 姓名:钉钉userId,姓名:钉钉userId
PINXIANG_OPS_USERS=
PINXIANG_PENDING_TTL_SEC=3600
PINXIANG_OPS_PENDING_TTL_SEC=604800

# ========== 流程4 分仓拼箱 ==========
LCL_BASE_DIR=apps/lcl_bot
# 运营名单与流程三共用 PINXIANG_OPS_USERS

# ========== 轨迹主动推送 track_notify ==========
PINGYI_BASE_URL=http://hzpy.rtb56.com
PINGYI_APP_TOKEN=
PINGYI_APP_KEY=
PINGYI_TIMEOUT_SEC=60
PINGYI_RETRIES=2
LOGISTICS_GATEWAY_BASE_URL=http://host.docker.internal:18743
LOGISTICS_GATEWAY_API_KEY=
LOGISTICS_GATEWAY_TIMEOUT_SEC=240
TRACK_QUERY_WORKERS=4
TRACK_SEND_EXCEL=0
TRACK_DINGTALK_DOC_KEY=
TRACK_DINGTALK_SHEET_ID=
TRACK_DINGTALK_VIEW_ID=
TRACK_OPERATOR_UNION_ID=
TRACK_CARRIER_KEYWORDS=平谊,龙舟,美通,堡森
# 美通 V1.0：物流编号 → getTrackInfo
MEITONG_BASE_URL=https://www.szaaf.com
MEITONG_USERNAME=
MEITONG_PASSWORD=
MEITONG_TIMEOUT_SEC=30
MEITONG_RETRIES=2
TRACK_SHIP_YEAR=2026
TRACK_NOTIFY_STATE_DIR=apps/track_notify/.state
