FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.lock .
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG PIP_FALLBACK_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir \
    -i ${PIP_INDEX_URL} -r requirements.lock \
    || pip install --no-cache-dir -i ${PIP_FALLBACK_INDEX_URL} -r requirements.lock

COPY apps/__init__.py /app/apps/__init__.py
COPY apps/split_bot/ /app/apps/split_bot/
COPY shared /app/shared

ENV PDF_SPLIT_WORKSPACE=/app/.bot-workspace

CMD ["python", "-m", "apps.split_bot.main"]

